# Windows-container equivalent of the Linux Dockerfile.
# GitHub's Windows runners only run Windows containers, so a Linux base image cannot be built there.
# Serves the same WAR (target/nano.war, built by "mvn clean package") as the root app on port 8080.
ARG WINDOWS_LTSC=ltsc2025
FROM eclipse-temurin:21-jdk-windowsservercore-${WINDOWS_LTSC}

SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ENV TOMCAT_VERSION=10.1.34

RUN Invoke-WebRequest -Uri ('https://archive.apache.org/dist/tomcat/tomcat-10/v{0}/bin/apache-tomcat-{0}-windows-x64.zip' -f $env:TOMCAT_VERSION) -OutFile C:\tomcat.zip; \
    Expand-Archive C:\tomcat.zip -DestinationPath C:\; \
    Rename-Item ('C:\apache-tomcat-{0}' -f $env:TOMCAT_VERSION) C:\tomcat; \
    Remove-Item C:\tomcat.zip; \
    Remove-Item -Recurse -Force C:\tomcat\webapps\*

COPY target/nano.war C:/tomcat/webapps/ROOT.war

WORKDIR C:/tomcat
EXPOSE 8080
CMD ["C:\\tomcat\\bin\\catalina.bat", "run"]
